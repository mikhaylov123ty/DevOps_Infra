[Unit]
Description = sausage-store-frontend

[Service]
User={{ frontend_user }}
Restart=always
AmbientCapabilities=CAP_NET_BIND_SERVICE
ExecStart=http-server {{ frontend_dir  }}/frontend \
-p {{ http_server_port }} \
--proxy {{ http_server_proxy }}
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
